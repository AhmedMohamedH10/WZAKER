{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wzaker",
  "version": "3.6.4",
  "identifier": "io.github.ahmedmohamedh10.wzaker",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npx serve src -p 1420"
  },
  "app": {
    "windows": [
      {
        "title": "وذكر",
        "width": 294,
        "height": 390,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "rpm": {
        "release": "1"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AhmedMohamedH10/WZAKER/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3OTBDRjI4NTNEOTgxMDIKUldRQ2dkbFRLTStRMXhQbm0yaEZZbDF2ZVFhbE1UWFlXeW9xejBFUTlnT096TkdEb2hVZzkzZU8K",
      "windows": [],
      "dialog": true,
      "active": true
    }
  }
}